APP_NAME=AlumIA
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Copy the Session Pooler values from Supabase Connect. Never commit .env.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=alumia
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=5

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# true on HTTPS deployments; false only for local HTTP development.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=local
